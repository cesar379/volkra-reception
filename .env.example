# ─────────────────────────────────────────────────────────────────────────────
# Volkra Recepción · variables de entorno
# Sin ninguna variable, la app arranca en modo local: Postgres embebido (PGlite),
# datos de demostración y acceso de demo. Copia este fichero a .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la app (la que verá Vapi y Google). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Secreto para firmar sesiones de demo y estados OAuth. OBLIGATORIO en producción.
# Genera uno con:  openssl rand -base64 32
APP_SECRET=

# Clave de 32 bytes (base64) para cifrar los tokens de Google. OBLIGATORIA en producción.
# Genera una con:  openssl rand -base64 32
ENCRYPTION_KEY=

# ── Base de datos (Supabase) ────────────────────────────────────────────────
# Cadena de conexión del pooler de Supabase (modo transacción, puerto 6543).
# Vacío = base de datos embebida local en .data/pglite
DATABASE_URL=
# Crear datos de demostración en la base embebida (true/false)
SEED_DEMO=true

# ── Autenticación (Supabase Auth) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mostrar las cuentas de demostración aunque Supabase esté configurado (para un despliegue de ventas)
ALLOW_DEMO_LOGIN=false

# ── Voz: Vapi ───────────────────────────────────────────────────────────────
# Secreto compartido: Vapi lo envía como "Authorization: Bearer <secreto>". Sin él, el webhook rechaza todo.
VAPI_WEBHOOK_SECRET=
# Clave privada de Vapi (solo para el script de configuración del número)
VAPI_API_KEY=

# ── Voz alternativa: ElevenLabs Agents (opcional) ───────────────────────────
# Bearer que ElevenLabs envía en /api/elevenlabs/init y /api/elevenlabs/tools/*
ELEVENLABS_TOOLS_SECRET=
# Secreto HMAC del webhook post-call (lo genera ElevenLabs)
ELEVENLABS_WEBHOOK_SECRET=
# 1 = enviar también el saludo del negocio en el inicio de llamada (no permitido en el plan Free de ElevenLabs)
ELEVENLABS_OVERRIDE_FIRST_MESSAGE=
# Clave de API de ElevenLabs: solo para «Probar el asistente» por voz desde el panel (agentes privados)
ELEVENLABS_API_KEY=

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
# Simulador con IA real, chat web y WhatsApp. En llamadas, Claude lo invoca Vapi con su proveedor "anthropic".
ANTHROPIC_API_KEY=

# ── Google Calendar ─────────────────────────────────────────────────────────
# OAuth 2.0 "Aplicación web". URI de redirección: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WhatsApp Business (Cloud API de Meta) ───────────────────────────────────
# Secreto de la app de Meta (Configuración de la app → Básica): firma de los webhooks
WHATSAPP_APP_SECRET=
# Texto libre que pones en Meta al configurar el webhook ${APP_URL}/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Opcional: token permanente de un usuario del sistema, si todos los números son de la cuenta de la plataforma.
# Cada negocio puede guardar el suyo en Configuración → WhatsApp.
WHATSAPP_ACCESS_TOKEN=
# Versión de la Graph API (por defecto v23.0)
WHATSAPP_GRAPH_VERSION=
# Solo en local, para probar sin Meta con npm run whatsapp:local: http://127.0.0.1:4599. En producción, vacío.
WHATSAPP_GRAPH_URL=

# ── Cobro (Stripe) ──────────────────────────────────────────────────────────
# Suscripción mensual de cada negocio. Ver docs/10-cobros-stripe.md. Sin ellas, el cobro aparece como «no configurado».
STRIPE_SECRET_KEY=
# Secreto de firma del webhook ${APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# ID del precio mensual (price_…)
STRIPE_PRICE_ID=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Volkra Recepción <citas@tudominio.es>"

# ── Alertas para Volkra ─────────────────────────────────────────────────────
# Recibe los errores de producción, el aviso de saldo de Anthropic agotado y el resumen diario de fallos.
# Vacío = sin alertas. Requiere el email configurado (RESEND_API_KEY y EMAIL_FROM).
ALERT_EMAIL=

# ── Tareas programadas ──────────────────────────────────────────────────────
# Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>" (Google Calendar; recordatorios de cita y borrado RGPD de chats y WhatsApp)
CRON_SECRET=

# ── Textos legales ──────────────────────────────────────────────────────────
# Datos del titular que exige la LSSI en /privacidad, /condiciones y /encargo-tratamiento.
# Vacíos = las páginas muestran [TITULAR], [NIF] y [DOMICILIO].
LEGAL_TITULAR=
LEGAL_NIF=
LEGAL_DOMICILIO=
